# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE — PORTFÓLIO DONIZETTI BATISTA
# Copie este arquivo para `.env` e preencha os valores conforme seu ambiente.
# ==============================================================================

# 1. Integração GitHub REST API
# Usuário público utilizado para buscar repositórios em `githubService.ts`
VITE_GITHUB_USERNAME=donizetti-dev

# 2. Integração Supabase (Opcional em Dev / Fallback Automático para localStorage)
# Caso não sejam preenchidas, o `dataService` operará automaticamente em modo local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. Credenciais Administrativas para Modo Local / Testes E2E (Fallback Auth)
# Utilizadas apenas quando o Supabase não está configurado ou durante os testes Playwright
VITE_ADMIN_EMAIL=admin@donizetti.dev
VITE_ADMIN_PASSWORD=admin123
